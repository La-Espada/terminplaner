# Vorlage für .env – kopieren mit: cp .env.example .env
# Die echte .env wird NICHT committet (siehe .gitignore).

# --- Datenbank ---
# Port 5433 statt des üblichen 5432: Auf dem Entwicklungsrechner belegt eine native
# PostgreSQL-Installation (Windows-Dienst postgresql-x64-17) bereits 5432. Der Container
# wäre von außen sonst nicht erreichbar — Verbindungen landeten stumm bei der falschen
# Datenbank und scheiterten mit "Rolle existiert nicht" oder einem Authentifizierungsfehler.
#
# Ebenfalls Absicht: 127.0.0.1 statt localhost in der DATABASE_URL. Unter Windows löst
# localhost zuerst auf IPv6 (::1) auf, Docker veröffentlicht Ports aber auf IPv4.
POSTGRES_USER=terminplaner
POSTGRES_PASSWORD=terminplaner_dev
POSTGRES_DB=terminplaner
POSTGRES_PORT=5433
DATABASE_URL=postgresql://terminplaner:terminplaner_dev@127.0.0.1:5433/terminplaner

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Mail (lokal über Mailpit) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Lokal fängt Mailpit alles ab — es verlässt nichts den Rechner.
# Für echte Zustellung: Host, Port und Zugangsdaten eines EU-Anbieters eintragen.
# Solange SMTP_USER leer ist, wird ohne Anmeldung versendet (nur für Mailpit).
# Achtung: Ein externer Mailversender ist Auftragsverarbeiter — AV-Vertrag nötig,
# siehe docs/CHECKLISTE.md.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kosmetikstudio <noreply@example.invalid>"

# --- Anwendung ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Basis-URL für Links in E-Mails (Verifizierung, Passwort-Reset)
APP_BASE_URL=http://localhost:3000

# Erlaubte Herkünfte für Browser-Clients, kommagetrennt. Leer = keine erlaubt.
# 8081 ist Expo im Browser, 5173 das spätere Admin-Web mit Vite.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Zeitzone des Studios. Alle Zeitstempel liegen in UTC in der Datenbank,
# diese Angabe steuert nur Anzeige und Berechnung der Arbeitszeiten.
STUDIO_TIMEZONE=Europe/Vienna

# --- Auth ---
# Für die Entwicklung beliebige lange Zufallswerte, in Produktion aus dem Secret-Store.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=bitte-ersetzen
JWT_REFRESH_SECRET=bitte-ebenfalls-ersetzen
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Buchungsregeln (noch mit dem Studio zu klären, siehe docs/UMSETZUNG.md) ---
# Wie lange vorher darf eine Kundin kostenfrei stornieren?
CANCELLATION_DEADLINE_HOURS=24
# Wie kurzfristig darf gebucht werden?
BOOKING_LEAD_TIME_MINUTES=120
# Wie weit im Voraus darf gebucht werden?
BOOKING_HORIZON_DAYS=90
# Raster der angebotenen Slots
SLOT_GRANULARITY_MINUTES=15
# Buchungen sofort bestätigen (true) oder erst nach Freigabe durch das Studio (false)?
AUTO_CONFIRM_BOOKINGS=true

# --- Aufbewahrungsfristen (DSGVO) ---
# Siehe docs/PLAN.md Abschnitt 8.4.1. Die Werte sind Vorschläge und gehören mit der
# juristischen Prüfung abgestimmt, bevor die Löschjobs scharf geschaltet werden.

# Gesundheitsdaten: treatment_notes und appointments.customer_note_encrypted
HEALTH_DATA_RETENTION_MONTHS=24
# Termine – gebunden an die Aufbewahrungspflicht für abgerechnete Leistungen
APPOINTMENT_RETENTION_YEARS=7
# Audit-Log, normale Einträge
AUDIT_LOG_RETENTION_DAYS=365
# Audit-Log, Lesezugriffe auf Gesundheitsdaten (is_art9_access) – Rechenschaftspflicht
AUDIT_LOG_ART9_RETENTION_DAYS=1095

# Backups: täglich gesichert, jede Sicherung 30 Tage aufbewahrt – also immer 30 parallele
# Stände. Das ist keine Einstellung der Anwendung, sondern der Backup-Job liest sie; sie
# steht hier, weil sie zu den Löschfristen gehört: Eine gelöschte Person verschwindet
# spätestens BACKUP_RETENTION_DAYS nach der Anonymisierung auch aus der letzten Sicherung.
# Bewusst FLACH, keine gestaffelte Langzeitaufbewahrung (keine Wochen- oder Monatsarchive)
# – die würden gelöschte Daten monatelang am Leben halten.
BACKUP_RETENTION_DAYS=30

# --- Verschlüsselung der Art.-9-Felder ---
#
# ACHTUNG: Dies ist EIN globaler Schlüssel und taugt NUR für die Entwicklung.
#
# Ein globaler Schlüssel kann nicht pro Person vernichtet werden – ihn zu löschen würde
# die Daten ALLER Kundinnen unlesbar machen. Damit ist Crypto-Shredding als Weg, gelöschte
# Daten auch aus Backups zu entfernen, ausgeschlossen.
#
# Für Produktion ist in Schritt 39 zu entscheiden: ein Schlüssel pro Person, verwaltet im
# KMS/Vault und NICHT in der Datenbank. Nur dann verschwinden die Gesundheitsdaten einer
# einzelnen Person auch aus allen Backups. Siehe docs/CHECKLISTE.md.
#
# Lokal erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_DATA_ENCRYPTION_KEY=nur-fuer-entwicklung-bitte-ersetzen
